# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit file .env)
PORT=3005
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=KyUcStudioDB

# Chuỗi bí mật để ký JWT, đặt dài và khó đoán
# BẮT BUỘC đặt chuỗi ngẫu nhiên riêng (ít nhất 16 ký tự). Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cookie đăng nhập: khi deploy HTTPS đặt COOKIE_SECURE=true;
# frontend và backend khác domain thì COOKIE_SAMESITE=none (bắt buộc kèm COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# true (mặc định): phải đăng nhập mới tạo đơn/thanh toán được; false: cho khách vãng lai đặt luôn
REQUIRE_LOGIN_TO_BOOK=true

# Domain frontend được gọi API, nhiều domain cách nhau bởi dấu phẩy (bỏ trống = cho phép tất cả)
CLIENT_URL=http://localhost:4200

# Tài khoản admin được tạo khi chạy: npm run seed
ADMIN_EMAIL=admin@kyucstudio.vn
# Mật khẩu mạnh riêng của nhóm, KHÔNG dùng mật khẩu ví dụ. Bỏ trống thì seed tự tạo ngẫu nhiên và in ra 1 lần
ADMIN_PASSWORD=
ADMIN_PHONE=0900000000

# Thông tin nhận cọc để tạo mã VietQR (mã ngân hàng xem tại https://api.vietqr.io/v2/banks)
BANK_ID=VCB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=KY UC STUDIO

# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ -> nhận TmnCode + HashSecret qua email
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang kết quả của frontend, VNPay chuyển khách về đây sau khi thanh toán
VNP_RETURN_URL=http://localhost:4200/thanh-toan/ket-qua

# Gửi SMS (mã OTP quên mật khẩu): console = in mã ra terminal (mặc định, miễn phí); twilio = gửi SMS thật
SMS_PROVIDER=console
# Twilio: đăng ký dùng thử tại https://www.twilio.com/try-twilio -> lấy Account SID, Auth Token, số điện thoại Twilio
# Tài khoản dùng thử chỉ gửi được tới số đã xác minh (Verified Caller IDs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gửi email (thông báo đổi mật khẩu, OTP khi khách nhập email). Gmail: bật xác minh 2 bước -> tạo "Mật khẩu ứng dụng" (App Password)
# Bỏ trống thì mã OTP được in ra console của server để test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ký Ức Studio <your.email@gmail.com>

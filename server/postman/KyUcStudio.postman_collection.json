            },
            "description": "Nếu báo 409 là giờ này đã có người giữ/đặt (vd chạy lần 2): đổi startTime sang giờ khác."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"holdId\", pm.response.json().holdId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ngày chụp = hôm nay + 7 ngày, ngày đổi lịch = hôm nay + 9 ngày",
                  "const d = n => new Date(Date.now() + 7*3600e3 + n*864e5).toISOString().slice(0,10);",
                  "pm.collectionVariables.set(\"shootDate\", d(7));",
                  "pm.collectionVariables.set(\"newDate\", d(9));"
                ]
              }
            }
          ]
        },

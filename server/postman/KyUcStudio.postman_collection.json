    {
      "name": "4. Đặt lịch (chạy theo thứ tự)",
      "item": [
        {
          "name": "Xem giờ trống",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slots?date={{shootDate}}&packageId=102",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slots"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{shootDate}}"
                },
                {
                  "key": "packageId",
                  "value": "102"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ngày chụp = hôm nay + 7 ngày, ngày đổi lịch = hôm nay + 9 ngày",
                  "const d = n => new Date(Date.now() + 7*3600e3 + n*864e5).toISOString().slice(0,10);",
                  "pm.collectionVariables.set(\"shootDate\", d(7));",
                  "pm.collectionVariables.set(\"newDate\", d(9));"
                ]
              }
            }
          ]
        },
        {
          "name": "Báo giá",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": 102,\n  \"conceptCode\": \"CD01\",\n  \"addons\": [\n    {\n      \"addon_id\": 1,\n      \"quantity\": 1\n    }\n  ],\n  \"voucherCode\": \"KYUC2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tổng 2.550.000, cọc 765.000\", () => { const b = pm.response.json(); pm.expect(b.totalAmount).to.eql(2550000); pm.expect(b.depositAmount).to.eql(765000); });"
                ]
              }
            }
          ]
        },
